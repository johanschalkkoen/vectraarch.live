# VectraArch Legacy — Paygate (PayFast) environment variables
# Append these to legacy.vectraarch.live/.env

# ── PayFast credentials ───────────────────────────────────────────────────────
# Get these from your PayFast dashboard → Settings → Integration.
# Leave as-is to run against PayFast's public sandbox for testing.
PAYFAST_MODE=sandbox                       # 'sandbox' or 'live'
PAYFAST_MERCHANT_ID=10000100               # sandbox default; replace for live
PAYFAST_MERCHANT_KEY=46f0cd694581a         # sandbox default; replace for live
PAYFAST_PASSPHRASE=                        # set the SAME passphrase configured in your PayFast account

# ── Trial window ──────────────────────────────────────────────────────────────
# Days of free access before a subscription is required. Existing users get a
# fresh trial from the first deploy that adds the subscription columns.
TRIAL_DAYS=3

# Note: PUBLIC_BASE_URL (already in your .env) is used to build the PayFast
# return / cancel / notify URLs, so make sure it points at the live host.
