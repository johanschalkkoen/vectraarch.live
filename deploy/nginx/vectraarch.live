# =============================================================================
# VectraArch · vectraarch.live — main static site + contact APIs
#
# Version-controlled copy of /etc/nginx/sites-enabled/vectraarch.live
# Apply with:  sudo cp deploy/nginx/vectraarch.live /etc/nginx/sites-enabled/
#              sudo nginx -t && sudo systemctl reload nginx
#
# The Node apps run on their own subdomains (forge./conduit./legacy.).
# The old path-based proxies under this domain were broken once the apps
# moved to subdomain mode, so they are replaced with 301 redirects.
# =============================================================================

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name vectraarch.live;

    ssl_certificate     /etc/letsencrypt/live/vectraarch.live/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vectraarch.live/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; preload" always;
    add_header X-Frame-Options            "SAMEORIGIN"               always;
    add_header X-Content-Type-Options     "nosniff"                  always;
    add_header Referrer-Policy            "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy         "camera=(), microphone=(), geolocation=(), payment=()" always;

    server_tokens off;
    client_max_body_size 50M;

    root  /var/www/vectraarch.live;
    index index.html;

    # ------------------------------------------------------------------
    # Shared CSS
    # ------------------------------------------------------------------
    location /shared/ {
        alias /var/www/vectraarch.live/shared/;
        add_header Cache-Control               "public, max-age=86400";
        add_header Access-Control-Allow-Origin "*";
    }

    # ------------------------------------------------------------------
    # Static subdirectories
    # ------------------------------------------------------------------
    location /bo7/ { try_files $uri $uri/ /bo7/index.html; }

    # ------------------------------------------------------------------
    # Moved apps — 301 redirect to their own subdomains
    # (Forge/Conduit/Legacy run in subdomain mode with root-relative
    #  URLs; the old path-based proxies here no longer worked.)
    # ------------------------------------------------------------------
    location /forge/   { rewrite ^/forge/(.*)$   https://forge.vectraarch.live/$1   permanent; }
    location /conduit/ { rewrite ^/conduit/(.*)$ https://conduit.vectraarch.live/$1 permanent; }
    location /legacy/  { rewrite ^/legacy/(.*)$  https://legacy.vectraarch.live/$1  permanent; }

    # ------------------------------------------------------------------
    # Contact / booking API proxies -> VectraArchCOMS :3099
    # Used by the static marketing pages on this domain.
    # ------------------------------------------------------------------
    location = /api/contact {
        limit_except POST { deny all; }
        limit_req zone=contact burst=3 nodelay;
        proxy_pass           http://127.0.0.1:3099/contact;
        proxy_http_version   1.1;
        proxy_set_header     Host             $host;
        proxy_set_header     X-Real-IP        $remote_addr;
        proxy_set_header     X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_read_timeout   10s;
        proxy_send_timeout   10s;
        client_max_body_size 16k;
    }

    location = /api/booking {
        limit_except POST { deny all; }
        limit_req zone=contact burst=3 nodelay;
        proxy_pass           http://127.0.0.1:3099/bo7-booking;
        proxy_http_version   1.1;
        proxy_set_header     Host             $host;
        proxy_set_header     X-Real-IP        $remote_addr;
        proxy_set_header     X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_read_timeout   10s;
        proxy_send_timeout   10s;
        client_max_body_size 16k;
    }

    location = /api/forge {
        limit_except POST { deny all; }
        limit_req zone=contact burst=3 nodelay;
        proxy_pass           http://127.0.0.1:3099/forge;
        proxy_http_version   1.1;
        proxy_set_header     Host             $host;
        proxy_set_header     X-Real-IP        $remote_addr;
        proxy_set_header     X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_read_timeout   10s;
        proxy_send_timeout   10s;
        client_max_body_size 16k;
    }

    location = /api/legacy {
        limit_except POST { deny all; }
        limit_req zone=contact burst=3 nodelay;
        proxy_pass           http://127.0.0.1:3099/legacy;
        proxy_http_version   1.1;
        proxy_set_header     Host             $host;
        proxy_set_header     X-Real-IP        $remote_addr;
        proxy_set_header     X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_read_timeout   10s;
        proxy_send_timeout   10s;
        client_max_body_size 16k;
    }

    # ------------------------------------------------------------------
    # Identity API -> VectraArchIdentity :3200
    # NOTE: also reachable at api.vectraarch.live. This path is redundant
    # and can be removed if nothing on the main site calls /api/identity/*.
    # ------------------------------------------------------------------
    location /api/identity/ {
        proxy_pass         http://127.0.0.1:3200/api/identity/;
        proxy_http_version 1.1;
        proxy_set_header   Host      $host;
        proxy_set_header   X-Real-IP $remote_addr;
    }

    # ------------------------------------------------------------------
    # Root — main site
    # ------------------------------------------------------------------
    location / {
        try_files $uri $uri/ =404;
    }
}

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name vectraarch.live;
    return 301 https://$host$request_uri;
}
